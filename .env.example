# =====================================================================
#  Refer & Earn — environment configuration
#
#  Copy this file to `.env` and fill in the real values.
#  NEVER commit `.env` — it is already listed in .gitignore.
#
#  On shared hosting without .env support you can instead set these as
#  real environment variables (cPanel → MultiPHP INI / SetEnv, Apache
#  SetEnv, Docker env, systemd Environment=, etc.).
# =====================================================================

# --- Application -----------------------------------------------------
# local | production
APP_ENV=production

# 1 = show PHP errors on screen (never in production), 0 = hide them
APP_DEBUG=0

# Public base URL, no trailing slash. Used for links and the webhook URL.
#
# OPTIONAL — leave it commented out and the app auto-detects the domain from
# each request (honouring X-Forwarded-Proto/Host behind a proxy). That means
# the same code works on localhost, staging and production with no edits.
#
# Set it explicitly only when the detected origin is wrong, e.g. the app is
# served from a subdirectory or behind a proxy that rewrites the host.
# APP_URL=https://yourdomain.com

APP_TIMEZONE=Asia/Kolkata

# --- Database --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=refer_earn
DB_USER=refer_earn_user
DB_PASS=change-me-to-a-strong-password

# --- Session ---------------------------------------------------------
SESSION_NAME=refer_earn_sid
# 8 hours, in seconds
SESSION_LIFETIME=28800

# --- Logging ---------------------------------------------------------
# Absolute path to a writable directory OUTSIDE the web root.
# Leave empty to use the PHP default (usually the Apache error log).
LOG_DIR=
